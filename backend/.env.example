# Credenciais apenas para desenvolvimento local.
DATABASE_URL=postgresql+psycopg://leilao:leilao@localhost:5432/leilao
CORS_ORIGINS=["http://localhost:5173"]

# Chaves HMAC da auditoria e dos pseudônimos (64 hex cada, distintas, fora do banco).
# Gere cada uma com: openssl rand -hex 32
# Em ENVIRONMENT=production a API recusa chaves iguais ou as de desenvolvimento do compose.
CHAVE_INTEGRIDADE=
CHAVE_PRIVACIDADE=

# Opcionais (valores padrão na tabela de variáveis do README).
ENVIRONMENT=development
SEED_DEMO=true
# SEED_INTERVALO_S=3600
# SENHA_DEMO=leilao-demo-2026
# FRONTEND_DIST=../frontend/dist
